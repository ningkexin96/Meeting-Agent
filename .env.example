DATABASE_URL="file:./dev.db"

# ===== 注册与租户 =====
# 是否允许访客自助注册。
# 本项目定位是可直接运行的演示，因此示例默认开启；
# 若部署到公网且不希望陌生人注册，改为 0 或删掉这一行（生产环境未设置时默认关闭）。
ALLOW_PUBLIC_REGISTER="1"
# 1 = 所有注册用户共享「演示团队」租户（仅用于本地演示）
# 0 = 每个账号独立租户，注册者即该租户 owner（更安全，推荐）
DEMO_SHARED_TENANT="0"

# ===== LLM =====
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
# 1 = 不调真实模型，走确定性输出（演示兜底）
MOCK_LLM="1"

# ===== ASR =====
# mock = 用预置转写；real = 调外部 ASR HTTP 服务
ASR_PROVIDER="mock"
# real 模式的上游类型：openai（/audio/transcriptions）| funasr（/transcribe）
ASR_KIND="openai"
# 上游地址，例如：
#   whisper.cpp server : http://127.0.0.1:8080/v1
#   faster-whisper     : http://127.0.0.1:8000/v1
#   FunASR runtime     : http://127.0.0.1:10095
ASR_BASE_URL=""
ASR_API_KEY=""
ASR_MODEL="whisper-1"
ASR_TIMEOUT_MS="180000"
# 1 = 真实 ASR 失败时自动降级到预置转写（演示安全阀）
ASR_FALLBACK_TO_MOCK="0"

# ===== 存储 =====
STORAGE_DIR="./storage"
# ===== 真实模型调用参数（LLM 相关）=====
# 单次调用超时（毫秒）
LLM_TIMEOUT_MS="120000"
# 失败重试次数
LLM_MAX_RETRIES="2"
# ===== 阿里云百炼 DashScope 实时语音识别 =====
# ASR_PROVIDER=dashscope 时必填
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com"
DASHSCOPE_ASR_MODEL="paraformer-realtime-v2"
DASHSCOPE_ASR_SAMPLE_RATE="16000"
# ===== 说话人分离（Qwen-Audio-ASR 原生能力）=====
# ASR_PROVIDER=qwen 时生效。直接返回 speaker_id，无需注册声纹
DASHSCOPE_DIARIZE_MODEL="qwen-audio-3.1-asr-flash"
DASHSCOPE_DIARIZE="1"
DASHSCOPE_ASR_MAX_MS="300000"